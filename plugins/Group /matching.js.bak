import fetch from 'node-fetch';

let handler = async (m, { conn }) => {
    try {
        // جلب صور تطقيم من API
        let apiUrl = 'https://api.agatz.xyz/api/matching';
        let res = await fetch(apiUrl);
        let data = await res.json();

        if (!data.data || !data.data.boy || !data.data.girl) {
            // لو فشل، نجرب API تاني
            let apiUrl2 = 'https://raw.githubusercontent.com/Xov445447533/Xov11111/master/src/JSON/matching.json';
            let res2 = await fetch(apiUrl2);
            let json2 = await res2.json();
            let random = json2[Math.floor(Math.random() * json2.length)];
            data = { data: random };
        }

        // إرسال صورة الولد
        let msg1 = `   ⃝⃘︢︣֟፝ · ͟͟͞͞➳ 𝑴𝑨𝑿 𝑩𝑶𝑻
👦 *Boy*

💕 *تـطـقـيـم الـيـوم*

​➥ 𝑴𝑨𝑿 𝑩𝑶𝑻 👑
𓉘᳟ี ⃞̸͢𑁃 ̚𓉝᳟ี ͟͟͞͞┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦━┄꫶︦┄꯭๋━┄꯭๋━┄꫶︦╯`;

        await conn.sendMessage(m.chat, {
            image: { url: data.data.boy },
            caption: msg1
        }, { quoted: m });

        // إرسال صورة البنت
        let msg2 = `   ⃝⃘︢︣֟፝ · ͟͟͞͞➳ 𝑴𝑨𝑿 𝑩𝑶𝑻
👧 *Girl*

💕 *تـطـقـيـم الـيـوم*

💡 *للتالي اكتب .تطقيم*

​➥ 𝑴𝑨𝑿 𝑩𝑶𝑻 👑
𓉘᳟ี ⃞̸͢𑁃 ̚𓉝᳟ี ͟͟͞͞┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦━┄꫶︦┄꯭๋━┄꯭๋━┄꫶︦╯`;

        await conn.sendMessage(m.chat, {
            image: { url: data.data.girl },
            caption: msg2
        }, { quoted: m });

    } catch (err) {
        console.error('[تطقيم] error:', err.message);
        conn.reply(m.chat, '❌ *حدث خطأ في جلب الصور!*', m);
    }
};

handler.help = ['تطقيم', 'ماتشينج'];
handler.tags = ['group'];
handler.command = /^(تطقيم|ماتشينج|matching)$/i;
handler.group = true;

export default handler;