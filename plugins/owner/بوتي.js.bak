let handler = m => m;

handler.before = async function (m, { conn, isOwner, isROwner }) {
    if (!m.text) return false;
    
    let txt = m.text.trim();

    if (txt === "بوتي") {
        if (isOwner || isROwner) {
            let loveMessages = [
                '❤️ *قلب بوتك من جوه يا مطوري..*',
                '✨ *مطوري وحبيبي.. أمرك مطاع!*',
                '😍 *عُيون بوتك.. محتاج حاجة يا بطل؟*',
                '🫡 *حبك مطوري.. البوت كله فداك!*'
            ];
            let randomReply = loveMessages[Math.floor(Math.random() * loveMessages.length)];
            
            let msg = `   ⃝⃘︢︣֟፝ · ͟͟͞͞➳ 𝑴𝑨𝑿 𝑩𝑶𝑻
${randomReply}

👑 *أنت المطور بتاعي!*

​➥ 𝑴𝑨𝑿 𝑩𝑶𝑻 👑
𓉘᳟ี ⃞̸͢𑁃 ̚𓉝᳟ี ͟͟͞͞┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦━┄꫶︦┄꯭๋━┄꯭๋━┄꫶︦╯`;
            
            await m.reply(msg);
        } else {
            await m.reply(`   ⃝⃘︢︣֟፝ · ͟͟͞͞➳ 𝑴𝑨𝑿 𝑩𝑶𝑻\n*بس ي خول انت ع الصبح بطل بعبصه 🍻🥂*\n𓉘᳟ี ⃞̸͢𑁃 ̚𓉝᳟ี ͟͟͞͞┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦━┄꫶︦┄꯭๋━┄꯭๋━┄꫶︦╯`);
        }
        return true;
    }

    return false;
};

export default handler;